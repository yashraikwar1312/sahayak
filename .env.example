# ════════════════════════════════════════════════════════════════════════════════
# SAHAYAK EMERGENCY APP - ENVIRONMENT VARIABLES
# ════════════════════════════════════════════════════════════════════════════════

# ┌─────────────────────────────────────────────────────────────────────────────────
# │ IMPORTANT: For Vercel Deployment
# │ • DO NOT add sensitive values here
# │ • Configure all secrets in Vercel Dashboard: Settings > Environment Variables
# │ • Local development: Copy this file to .env.local and add your values
# │ • .env.local is automatically ignored by Git
# └─────────────────────────────────────────────────────────────────────────────────

# ┌─ AI & GEMINI CONFIGURATION ─┐
# Gemini AI API key for emergency classification and smart diagnosis
# Get from: https://ai.google.dev/
# Required for voice command analysis and AI-powered crisis classification
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ┌─ APPLICATION CONFIGURATION ─┐
# Base URL where the app is deployed
# For Vercel: https://your-project-name.vercel.app
# For local dev: http://localhost:5173
APP_URL="http://localhost:5173"

# ┌─ EMAIL SMTP CONFIGURATION ─┐
# For OTP verification and emergency notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_SENDER_EMAIL="sahayak@emergency.app"

# ┌─ OPTIONAL: MONITORING & LOGGING ─┐
# Uncomment to enable in production
# NODE_ENV="production"
# LOG_LEVEL="info"
